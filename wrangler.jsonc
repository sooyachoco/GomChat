{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gomchat",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "."
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
